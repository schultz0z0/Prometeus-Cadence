+  const jobs=(await c.query(`SELECT coalesce(sum((counts->>'inserted')::numeric),0)::int inserted,coalesce(sum((counts->>'found')::numeric),0)::int found,coalesce(sum((counts->>'pending')::numeric),0)::int pending FROM app.prospecting_job WHERE created_at>=$1 AND created_at<$2 AND $3::text IS NULL`,[q.from,q.to,q.cadenceId??null])).rows[0];Object.assign(totals,{executionInserted:jobs.inserted,executionFound:jobs.found,executionPending:jobs.pending});
