# Generate actual local values with npm run env:init. Never commit .env.local.
POSTGRES_PASSWORD=replace-with-random-value
CADENCE_AUTH_PASSWORD=replace-with-random-value
CADENCE_APP_PASSWORD=replace-with-random-value
MIGRATOR_DATABASE_URL=postgresql://cadence_owner:password@127.0.0.1:55432/prometeus_cadence
AUTH_DATABASE_URL=postgresql://cadence_auth:password@127.0.0.1:55432/prometeus_cadence
APP_DATABASE_URL=postgresql://cadence_app:password@127.0.0.1:55432/prometeus_cadence
TEST_MIGRATOR_DATABASE_URL=postgresql://cadence_owner:password@127.0.0.1:55432/prometeus_cadence_test
TEST_AUTH_DATABASE_URL=postgresql://cadence_auth:password@127.0.0.1:55432/prometeus_cadence_test
TEST_APP_DATABASE_URL=postgresql://cadence_app:password@127.0.0.1:55432/prometeus_cadence_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3210
APP_DATA_MODE=server
SMTP_HOST=127.0.0.1
SMTP_PORT=1125
MAILHOG_URL=http://127.0.0.1:8125

# Server-only, disabled until credentials, pinned actor contracts and limits are reviewed.
CADENCE_WORKER_PASSWORD=replace-with-random-value
WORKER_DATABASE_URL=postgresql://cadence_worker:password@127.0.0.1:55432/prometeus_cadence
AUTOMATIONS_SCHEDULER_ENABLED=false
TEST_WORKER_DATABASE_URL=postgresql://cadence_worker:password@127.0.0.1:55432/prometeus_cadence_test
CADENCE_RUNTIME_MODE=local
PROSPECTING_ENABLED=false
PROSPECTING_WORKSPACE_DAILY_UNITS={"candidates":0,"apifyRuns":0,"apolloPages":0,"jevCalls":0,"codexCalls":0,"openaiCalls":0,"geminiCalls":0}
PROSPECTING_GLOBAL_DAILY_UNITS={"candidates":0,"apifyRuns":0,"apolloPages":0,"jevCalls":0,"codexCalls":0,"openaiCalls":0,"geminiCalls":0}
PROSPECTING_GLOBAL_CONCURRENCY=1
APIFY_TOKEN=
APIFY_MAPS_ACTOR=compass/crawler-google-places
APIFY_MAPS_BUILD=
APIFY_WEB_ACTOR=apify/google-search-scraper
APIFY_WEB_BUILD=
APIFY_CNPJ_ACTOR=bigdavidson/brazil-cnpj-companies
APIFY_CNPJ_BUILD=
APIFY_MAX_CHARGE_USD=0
APIFY_MAPS_PPE=false
APIFY_WEB_PPE=false
APIFY_CNPJ_PPE=false
APOLLO_API_KEY=
APOLLO_MAX_PAGES=0
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
CODEX_LOCAL_ENABLED=false
CODEX_TEST_WORKSPACE_IDS=
CODEX_BINARY=
CODEX_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
PROSPECTING_SMOKE_WORKSPACE_IDS=

# WhatsApp infrastructure only. Actual company Meta/Twilio credentials go in the app.
# env:init generates role passwords, URLs and a random AES keyring in .env.local.
CADENCE_INGRESS_PASSWORD=replace-with-random-value
CADENCE_DISPATCH_PASSWORD=replace-with-random-value
INGRESS_DATABASE_URL=postgresql://cadence_ingress:password@127.0.0.1:55432/prometeus_cadence
DISPATCH_DATABASE_URL=postgresql://cadence_dispatcher:password@127.0.0.1:55432/prometeus_cadence
TEST_INGRESS_DATABASE_URL=postgresql://cadence_ingress:password@127.0.0.1:55432/prometeus_cadence_test
TEST_DISPATCH_DATABASE_URL=postgresql://cadence_dispatcher:password@127.0.0.1:55432/prometeus_cadence_test
CHANNEL_ACTIVE_KEY_ID=
CHANNEL_KEYRING_JSON=
CHANNEL_PUBLIC_BASE_URL=
MESSAGING_WORKER_ENABLED=false
WHATSAPP_SMOKE_ENABLED=false
# Optional local-only external smoke: set only for an explicitly reviewed pilot.
WHATSAPP_SMOKE_ALLOWLIST=[]
WHATSAPP_SMOKE_INPUT_FILE=
SMOKE_WORKSPACE_ID=
SMOKE_CONNECTION_ID=
SMOKE_TEST_PHONE=
SMOKE_COOKIE=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:3210/api/mail-oauth/google/callback

# Email infrastructure; account tokens/passwords belong in workspace settings.
MAIL_SYNC_ENABLED=false
EMAIL_SMOKE_ENABLED=false
EMAIL_SMOKE_ALLOWLIST=[]
EMAIL_SMOKE_INPUT_FILE=
